# AwaazSaathi — copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# Secret used to hash farmer phone numbers (any long random string)
PHONE_HASH_SECRET=change-me-to-a-long-random-string

# Nil-detection thresholds (tune live)
RETRIEVAL_MIN=0.30
GROUNDING_MIN=0.6

# Models
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash
GROQ_STT_MODEL=whisper-large-v3
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
AZURE_TTS_VOICE=ur-PK-AsadNeural

# Start in offline mode (true/false). Can also be toggled live from /admin.
OFFLINE_MODE=false

# Internet link for phones on other networks (optional). Without these, a Cloudflare quick tunnel is used (random address).
# ngrok free account: https://dashboard.ngrok.com -> Your Authtoken, and Domains -> "New Domain" gives one free fixed address.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# Order of tunnel tools to try
LINK_PROVIDERS=ngrok,cloudflare,localhostrun
